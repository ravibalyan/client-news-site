---
import AdminLayout from '../../../layouts/AdminLayout.astro';import {requireUser} from '../../../lib/auth';import {db} from '../../../lib/db';const user=await requireUser(Astro.request).catch(()=>null);if(!user)return Astro.redirect('/admin/login/');const rows=(await db().prepare('SELECT * FROM pages ORDER BY title').all()).results as {id:string;title:string;slug:string;content:string;status:string;seo_title:string;seo_description:string;updated_at:string}[];
---
<AdminLayout user={user} title="Pages"><h2>Create page</h2><form class="form" action="/api/admin/pages/" method="post"><label>Title<input name="title" required/></label><label>Slug<input name="slug" required/></label><label>Content (HTML supported)<textarea name="content" required></textarea></label><label>Status<select name="status"><option value="draft">Draft</option><option value="published">Published</option></select></label><label>SEO title<input name="seo_title"/></label><label>SEO description<input name="seo_description"/></label><button>Save page</button></form><h2>Existing pages</h2><table><thead><tr><th>Title</th><th>URL</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody>{rows.map(p=><tr><td>{p.title}</td><td>/{p.slug}/</td><td>{p.status}</td><td>{p.updated_at}</td><td><details><summary>Edit / delete</summary><form class="form" action={`/api/admin/pages/${p.id}/`} method="post"><input type="hidden" name="action" value="save"/><label>Title<input name="title" value={p.title} required/></label><label>Slug<input name="slug" value={p.slug} required/></label><label>Content<textarea name="content" required>{p.content}</textarea></label><label>Status<select name="status"><option value="draft" selected={p.status==='draft'}>Draft</option><option value="published" selected={p.status==='published'}>Published</option></select></label><label>SEO title<input name="seo_title" value={p.seo_title}/></label><label>SEO description<input name="seo_description" value={p.seo_description}/></label><button>Save page</button></form><form data-confirm="Delete this page?" action={`/api/admin/pages/${p.id}/`} method="post"><button style="background:#a33">Delete</button></form></details></td></tr>)}</tbody></table></AdminLayout>
