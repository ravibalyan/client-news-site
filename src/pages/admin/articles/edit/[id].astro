---
import AdminLayout from '../../../../layouts/AdminLayout.astro';import {requireUser} from '../../../../lib/auth';import {db} from '../../../../lib/db';const user=await requireUser(Astro.request).catch(()=>null);if(!user)return Astro.redirect('/admin/login/');const article=await db().prepare('SELECT a.*,ac.category_id FROM articles a LEFT JOIN article_categories ac ON ac.article_id=a.id WHERE a.id=?').bind(Astro.params.id).first<any>();if(!article)return new Response('Not found',{status:404});const cats=(await db().prepare('SELECT id,name FROM categories ORDER BY name').all()).results as {id:string;name:string}[];
---
<AdminLayout user={user} title="Edit article"><form class="form" action="/api/admin/articles/" method="post"><input type="hidden" name="id" value={article.id}/><label>Title<input name="title" value={article.title} required maxlength="200" /></label><label>Slug<input name="slug" value={article.slug} required /></label><label>Excerpt<textarea name="excerpt">{article.excerpt}</textarea></label><label>Article content (HTML supported)<textarea name="content" required>{article.content}</textarea></label><div class="split"><label>Category<select name="category_id">{cats.map(c=><option value={c.id} selected={article.category_id===c.id}>{c.name}</option>)}</select></label><label>Status<select name="status"><option value="draft" selected={article.status==='draft'}>Draft</option><option value="published" selected={article.status==='published'}>Published</option></select></label></div><div class="split"><label>Author<input name="author_name" value={article.author_name}/></label><label>Publication date<input name="published_at" value={article.published_at||''}/></label></div><label>Image URL<input name="image_url" value={article.image_url}/></label><label>Image alt text<input name="image_alt" value={article.image_alt}/></label><div class="split"><label>SEO title<input name="seo_title" value={article.seo_title}/></label><label>SEO description<input name="seo_description" value={article.seo_description}/></label></div><button>Save changes</button></form></AdminLayout>
