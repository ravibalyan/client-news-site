---
import AdminLayout from '../../../layouts/AdminLayout.astro';import {requireUser} from '../../../lib/auth';import {db} from '../../../lib/db';const user=await requireUser(Astro.request).catch(()=>null);if(!user)return Astro.redirect('/admin/login/');const cats=(await db().prepare('SELECT id,name FROM categories ORDER BY name').all()).results as {id:string;name:string}[];
---
<AdminLayout user={user} title="New article"><form class="form" action="/api/admin/articles/" method="post"><label>Title<input name="title" required maxlength="200" /></label><label>Slug<input name="slug" required pattern="[a-z0-9-]+" /></label><label>Excerpt<textarea name="excerpt" maxlength="500"></textarea></label><label>Article content (basic HTML supported)<textarea name="content" required></textarea></label><div class="split"><label>Category<select name="category_id" required>{cats.map(c=><option value={c.id}>{c.name}</option>)}</select></label><label>Status<select name="status"><option value="draft">Draft</option><option value="published">Published</option></select></label></div><div class="split"><label>Author<input name="author_name" value={user.name} /></label><label>Publication date<input name="published_at" placeholder="YYYY-MM-DD HH:MM:SS" /></label></div><label>Image URL<input name="image_url" value="/images/placeholder.svg" /></label><label>Image alt text<input name="image_alt" /></label><div class="split"><label>SEO title<input name="seo_title" maxlength="200" /></label><label>SEO description<input name="seo_description" maxlength="320" /></label></div><button>Save article</button></form></AdminLayout>
