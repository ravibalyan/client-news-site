---
import AdminLayout from '../../../layouts/AdminLayout.astro';import {requireUser} from '../../../lib/auth';import {db} from '../../../lib/db';
const user=await requireUser(Astro.request).catch(()=>null);if(!user)return Astro.redirect('/admin/login/');const q=Astro.url.searchParams.get('q')||'';const rows=(await db().prepare(`SELECT a.id,a.title,a.slug,a.status,a.updated_at,c.name category FROM articles a LEFT JOIN article_categories ac ON ac.article_id=a.id LEFT JOIN categories c ON c.id=ac.category_id WHERE a.title LIKE ? ORDER BY a.updated_at DESC LIMIT 100`).bind(`%${q.slice(0,80)}%`).all()).results as {id:string;title:string;slug:string;status:string;updated_at:string;category:string}[];
---
<AdminLayout user={user} title="Articles"><p><a class="button" href="/admin/articles/new/">＋ New article</a></p>{Astro.url.searchParams.has('saved')&&<p class="notice">Article saved.</p>}<form class="search"><input name="q" value={q} placeholder="Find an article"/><button>Search</button></form><table><thead><tr><th>Title</th><th>Category</th><th>Status</th><th>Updated</th><th>Actions</th></tr></thead><tbody>{rows.map(a=><tr><td><a href={`/admin/articles/edit/${a.id}/`}>{a.title}</a></td><td>{a.category}</td><td>{a.status}</td><td>{a.updated_at}</td><td><form data-confirm-delete action={`/api/admin/articles/${a.id}/`} method="post"><button name="action" value={a.status==='published'?'unpublish':'publish'}>{a.status==='published'?'Unpublish':'Publish'}</button> <button name="action" value="delete" style="background:#a33">Delete</button></form></td></tr>)}</tbody></table></AdminLayout>
