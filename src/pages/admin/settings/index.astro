---
import AdminLayout from '../../../layouts/AdminLayout.astro';import {requireSuperAdmin} from '../../../lib/auth';import {setting} from '../../../lib/db';const user=await requireSuperAdmin(Astro.request).catch(()=>null);if(!user)return Astro.redirect('/admin/login/');const keys=['site_name','site_tagline','admin_email','default_seo_title','default_seo_description','default_social_image','logo_url','ads_enabled','ads_publisher','ads_slot','ads_placement','head_scripts_enabled','head_scripts_code','body_start_code'];const values=Object.fromEntries(await Promise.all(keys.map(async k=>[k,await setting(k)])));
---
<AdminLayout user={user} title="Website, advertising & scripts">
{Astro.url.searchParams.has('saved')&&<p class="notice">Settings saved.</p>}
<p class="notice error"><strong>Privileged settings:</strong> Advertising snippets and tracking scripts can run JavaScript on every public page. Only paste code from a provider you trust. Do not paste secrets. Disabled code is not rendered.</p>
<form class="form" action="/api/admin/settings/" method="post" data-confirm="Save site-wide advertising or executable script settings? Only paste code you trust.">
<h2>Website settings</h2><label>Website name<input name="site_name" value={values.site_name}/></label><label>Tagline<input name="site_tagline" value={values.site_tagline}/></label><label>Administrator email<input type="email" name="admin_email" value={values.admin_email}/></label><label>Logo URL<input name="logo_url" value={values.logo_url}/></label><label>Default SEO title<input name="default_seo_title" value={values.default_seo_title}/></label><label>Default SEO description<textarea name="default_seo_description">{values.default_seo_description}</textarea></label><label>Default social image URL<input name="default_social_image" value={values.default_social_image}/></label>
<h2>Google advertising</h2><p>AdSense’s site-wide loader identifies your publisher; an ad unit uses a separate slot ID. The loader is inserted once in the public head when ads are enabled. Unit markup renders on article pages only.</p><label>Article ads<select name="ads_enabled"><option value="false" selected={values.ads_enabled!=='true'}>Disabled</option><option value="true" selected={values.ads_enabled==='true'}>Enabled</option></select></label><label>AdSense publisher ID<input name="ads_publisher" placeholder="ca-pub-0000000000000000" value={values.ads_publisher}/></label><label>Ad unit slot ID<input name="ads_slot" placeholder="0000000000" value={values.ads_slot}/></label><label>Article placement<select name="ads_placement"><option value="after_intro" selected={values.ads_placement!=='after_content'}>After introduction</option><option value="after_content" selected={values.ads_placement==='after_content'}>After article content</option></select></label>
<h2>Custom scripts and tracking</h2><p>GTM uses a site-wide head loader and typically a body-start noscript fallback. This editor displays pasted code as text; it is only rendered on the public site when enabled.</p><label>Render scripts<select name="head_scripts_enabled"><option value="false" selected={values.head_scripts_enabled!=='true'}>Disabled</option><option value="true" selected={values.head_scripts_enabled==='true'}>Enabled</option></select></label><label>Public head code<textarea name="head_scripts_code" spellcheck="false">{values.head_scripts_code}</textarea></label><label>Optional body-start code<textarea name="body_start_code" spellcheck="false">{values.body_start_code}</textarea></label><button>Save settings</button></form></AdminLayout>
