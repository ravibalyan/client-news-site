---
import AdminLayout from '../../../layouts/AdminLayout.astro';import {requireUser} from '../../../lib/auth';import {db} from '../../../lib/db';const user=await requireUser(Astro.request).catch(()=>null);if(!user)return Astro.redirect('/admin/login/');const rows=(await db().prepare('SELECT id,key,filename,content_type,size,created_at FROM media ORDER BY created_at DESC LIMIT 100').all()).results as {id:string;key:string;filename:string;content_type:string;size:number;created_at:string}[];
---
<AdminLayout user={user} title="Media library"><p class="notice">Images only: JPEG, PNG, WebP, or GIF, up to 5 MB. Executable uploads are rejected.</p>{Astro.url.searchParams.has('uploaded')&&<p class="notice">Upload complete.</p>}<form class="form" action="/api/admin/media/" method="post" enctype="multipart/form-data"><label>Choose image<input type="file" name="file" accept="image/jpeg,image/png,image/webp,image/gif" required/></label><button>Upload image</button></form><h2>Recent uploads</h2><div class="grid">{rows.map(m=><article class="card card-body"><img src={`/media/${m.key}`} alt="" style="width:100%;height:160px;object-fit:cover"/><strong>{m.filename}</strong><p class="muted">{m.content_type} · {Math.ceil(m.size/1024)} KB</p><input readonly value={`/media/${m.key}`} aria-label="Image URL"/></article>)}</div></AdminLayout>
