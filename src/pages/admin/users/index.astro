---
import AdminLayout from '../../../layouts/AdminLayout.astro';import {requireSuperAdmin} from '../../../lib/auth';import {db} from '../../../lib/db';const user=await requireSuperAdmin(Astro.request).catch(()=>null);if(!user)return Astro.redirect('/admin/login/');const rows=(await db().prepare('SELECT id,name,email,role,active,created_at,updated_at FROM admin_users ORDER BY created_at').all()).results as {id:string;name:string;email:string;role:string;active:number;created_at:string;updated_at:string}[];
---
<AdminLayout user={user} title="Admin users"><div class="notice">Only Super Admins can manage accounts. Temporary passwords should be shared securely and changed at first sign-in.</div><h2>Create account</h2><form class="form" action="/api/admin/users/" method="post"><label>Name<input name="name" required/></label><label>Email<input type="email" name="email" required/></label><label>Temporary password (12+ characters)<input type="password" name="password" minlength="12" required/></label><label>Role<select name="role"><option value="admin">Admin</option><option value="super_admin">Super Admin</option></select></label><button>Create account</button></form><h2>Accounts</h2>{rows.map(a=><details class="card card-body" style="margin-bottom:12px"><summary><strong>{a.name}</strong> · {a.email} · {a.role} · {a.active?'Active':'Inactive'}</summary><form class="form" action={`/api/admin/users/${a.id}/`} method="post"><input type="hidden" name="action" value="update"/><label>Name<input name="name" value={a.name} required/></label><label>Email<input name="email" type="email" value={a.email} required/></label><label>Role<select name="role"><option value="admin" selected={a.role==='admin'}>Admin</option><option value="super_admin" selected={a.role==='super_admin'}>Super Admin</option></select></label><label>Account state<select name="active"><option value="1" selected={a.active===1}>Active</option><option value="0" selected={a.active===0}>Inactive</option></select></label><button>Save account</button></form><form class="form" action={`/api/admin/users/${a.id}/`} method="post"><input type="hidden" name="action" value="reset"/><label>Set temporary password<input name="password" type="password" minlength="12" required/></label><button>Reset password and revoke sessions</button></form><form data-confirm="Delete this administrator account?" action={`/api/admin/users/${a.id}/`} method="post"><input type="hidden" name="action" value="delete"/><button style="background:#a33">Delete account</button></form><small>Created {a.created_at} · Updated {a.updated_at}</small></details>)}</AdminLayout>
