---
import AdminLayout from '../../../layouts/AdminLayout.astro';import {requireUser} from '../../../lib/auth';import {db} from '../../../lib/db';const user=await requireUser(Astro.request).catch(()=>null);if(!user)return Astro.redirect('/admin/login/');const rows=(await db().prepare('SELECT * FROM categories ORDER BY name').all()).results as {id:string;name:string;slug:string;description:string}[];
---
<AdminLayout user={user} title="Categories"><h2>Create category</h2><form class="form" action="/api/admin/categories/" method="post"><label>Name<input name="name" required /></label><label>Slug<input name="slug" required /></label><label>Description<textarea name="description"></textarea></label><button>Save category</button></form><h2>Existing categories</h2><table><thead><tr><th>Name</th><th>Slug</th><th>Description</th><th></th></tr></thead><tbody>{rows.map(c=><tr><td>{c.name}</td><td>{c.slug}</td><td>{c.description}</td><td><details><summary>Edit / delete</summary><form class="form" action="/api/admin/categories/" method="post"><input type="hidden" name="id" value={c.id}/><label>Name<input name="name" value={c.name} required/></label><label>Slug<input name="slug" value={c.slug} required/></label><label>Description<textarea name="description">{c.description}</textarea></label><button>Save</button></form><form data-confirm="Delete this category? Articles will remain but lose this category." action={`/api/admin/categories/${c.id}/`} method="post"><button style="background:#a33">Delete</button></form></details></td></tr>)}</tbody></table></AdminLayout>
