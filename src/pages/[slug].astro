---
import SiteLayout from '../layouts/SiteLayout.astro'; import { db } from '../lib/db'; import { safeContent } from '../lib/html';
const page = await db().prepare("SELECT * FROM pages WHERE slug=? AND status='published'").bind(Astro.params.slug).first<{title:string;content:string;seo_title:string;seo_description:string}>();
if (!page) return new Response('Page not found', { status: 404 });
---
<SiteLayout title={page.seo_title || page.title} description={page.seo_description}><article class="article"><h1>{page.title}</h1><div class="prose" set:html={safeContent(page.content)}></div></article></SiteLayout>
